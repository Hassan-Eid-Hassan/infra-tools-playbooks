[Unit]
Description=Prometheus
Wants=network-online.target
After=network-online.target

[Service]
User=prometheus
Group=prometheus
Type=simple
ExecStart=/opt/prometheus/prometheus-v3.11.3/prometheus \
--config.file /opt/prometheus/prometheus-v3.11.3/prometheus.yml \
--storage.tsdb.path /var/lib/prometheus/ \

[Install]
WantedBy=multi-user.target