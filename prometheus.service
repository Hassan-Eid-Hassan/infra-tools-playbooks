[Unit]
Description=Prometheus
Wants=network-online.target
After=network-online.target

[Service]
User=prometheus
Group=prometheus
Type=simple
ExecStart=/opt/prometheus/prometheus-3.11.3.linux-amd64/prometheus \
--config.file /opt/prometheus/prometheus-3.11.3.linux-amd64/prometheus.yml \
--storage.tsdb.path /var/lib/prometheus/ \

[Install]
WantedBy=multi-user.target
